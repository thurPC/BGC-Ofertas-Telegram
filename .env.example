# Filtro permanente de conteúdo: categorias e palavras-chave adicionais de exclusão
# (separadas por vírgula). Livros, e-books, audiolivros, mangás, HQs, revistas,
# apostilas, enciclopédias e dicionários já são bloqueados por padrão.
OFFER_EXCLUDE_CATEGORIES=
OFFER_EXCLUDE_KEYWORDS=
