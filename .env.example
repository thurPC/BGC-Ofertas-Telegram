TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
ADMIN_IDS=
NODE_ENV=production
OFFER_AUTO_PUBLISH=false
OFFER_CHECK_INTERVAL_MINUTES=30
MAX_OFFERS_PER_RUN=3
OFFER_PUBLISH_GAP_SECONDS=20
OFFER_MIN_SCORE=28
OFFER_REQUIRE_AFFILIATE_LINK=true

DATA_DIR=./data
LOG_LEVEL=info
OFFER_FEED_URL=https://raw.githubusercontent.com/thurPC/BGC-Ofertas-Telegram/main/feed.json
# Link do canal BGC PROMOS usado no "Compartilhe com os amigos" (opcional; pode ser editado com /modelo)
BGC_CHANNEL_LINK=

# Shopee Affiliate Open API (nunca grave valores reais neste arquivo)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_SUB_IDS=
SHOPEE_SEARCH_KEYWORDS=tecnologia,informática,periféricos,games,acessórios gamer,eletrônicos,casa,utilidades domésticas
# Se a Shopee responder 10020 com "Invalid Timestamp", ajuste a diferença do relógio
# em relação ao servidor (em segundos). Ex.: +30 se sua máquina está 30s atrasada.
SHOPEE_CLOCK_SKEW_SECONDS=0

OFFER_MAX_PRICE=
OFFER_MIN_DISCOUNT_PERCENT=
OFFER_ALLOWED_STORES=
# Janela 24h sem minutos. Vazio ou 0-23 = opera o dia todo. Ex.: 08-22
OFFER_ALLOWED_HOURS=
# Filtro permanente de conteúdo: categorias e palavras-chave adicionais de exclusão
# (separadas por vírgula). Livros, e-books, audiolivros, mangás, HQs, revistas,
# apostilas, enciclopédias e dicionários já são bloqueados por padrão.
OFFER_EXCLUDE_CATEGORIES=
OFFER_EXCLUDE_KEYWORDS=
# Ativa o bloqueio de livros e permite exceções de dispositivos (kindle, tablet, e-reader).
OFFER_EXCLUDE_BOOKS=true
OFFER_BOOK_EXCLUDE_KEYWORDS=
OFFER_BOOK_DEVICE_ALLOW_KEYWORDS=
